import nextflow.util.SysHelper

// Default inputs/parameters of the pipeline
params {
    min_cpus = 1
    min_memory = 1.MB

    max_cpus   = SysHelper.getAvailCpus()
    max_memory = SysHelper.getAvailMemory()

    gatk_command_mem_diff = 0.GB

    ucla_cds = true

    cache_intermediate_pipeline_steps = false

    docker_container_registry_uclahscds = "ghcr.io/uclahs-cds"
    docker_container_registry_theboutroslab = "ghcr.io/theboutroslab"

    gatk_version = "4.6.2.0"
    picard_version = "3.4.0"
    pipeval_version = "4.0.0-rc.2"
    gatkfilter_version = "v1.0.0"
    hail_version = "0.2.138"
    deepvariant_version = "1.10.0"
    docker_image_gatk = "broadinstitute/gatk:${params.gatk_version}"
    docker_image_picard = "${-> params.docker_container_registry_theboutroslab}/picard:${params.picard_version}"
    docker_image_pipeval = "${-> params.docker_container_registry_uclahscds}/pipeval:${params.pipeval_version}"
    docker_image_gatkfilter = "${-> params.docker_container_registry_uclahscds}/gatk:${params.gatkfilter_version}"
    docker_image_hail = "${-> params.docker_container_registry_theboutroslab}/hail:${params.hail_version}"
    docker_image_deepvariant = "google/deepvariant:${params.deepvariant_version}"

    emit_all_confident_sites = false
}

// Process specific scope
process {
    // Process results are stored to local cache.
    // If pipeline is launched with the 'resume' option, existing cache results will be used when available
    // rather than re-executing processes
    cache = true

    executor = 'local'

    // Other directives or options that should apply for every process

    // total amount of resources avaible to the pipeline
    cpus = params.max_cpus
    memory = params.max_memory
}

profiles {
    standard {
        apptainer {
            enabled = false
        }

        singularity {
            enabled = false
        }

        docker {
            enabled = true
            uid_and_gid = "-u \$(id -u):\$(id -g)"
            all_group_ids = "\$(for i in `id --real --groups`; do echo -n \"--group-add=\$i \"; done)"
            runOptions = "${uid_and_gid} ${all_group_ids}"
        }

        params.container_mount_flag = "-v"
    }

    // Define copy of default standard profile as docker to allow explicit docker selection
    // Profile aliasing isn't directly available so profile is copied
    docker {
        apptainer {
            enabled = false
        }

        singularity {
            enabled = false
        }

        docker {
            enabled = true
            uid_and_gid = "-u \$(id -u):\$(id -g)"
            all_group_ids = "\$(for i in `id --real --groups`; do echo -n \"--group-add=\$i \"; done)"
            runOptions = "${uid_and_gid} ${all_group_ids}"
        }

        params.container_mount_flag = "-v"
    }

    apptainer {
        docker {
            enabled = false
        }

        singularity {
            enabled = false
        }

        apptainer {
            enabled = true

            autoMounts = true
            ociAutoPull = true
        }

        params.container_mount_flag = "-B"
    }

    singularity {
        docker {
            enabled = false
        }

        apptainer {
            enabled = false
        }

        singularity {
            enabled = true

            autoMounts = true
            ociAutoPull = true
        }

        params.container_mount_flag = "-B"
    }
}
